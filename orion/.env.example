# --- Core ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
ORION_MODEL=claude-sonnet-5
# Lighter/cheaper model used for internal housekeeping (currently just
# background conversation-summary consolidation) — the user never sees its
# output directly, only the digest it produces, so a faster model costs
# nothing in answer quality.
ORION_FAST_MODEL=claude-haiku-4-5-20251001
ORION_NAME=Orion
ORION_DB_PATH=./orion.db
# Rotating log file (~5MB x 4 files kept) alongside console output — useful
# for diagnosing a headless/backgrounded run after the fact.
ORION_LOG_PATH=./orion.log

# --- Telegram interface (Android access) ---
# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user id (get it from @userinfobot).
# Only messages from this id will be answered — keeps your assistant private.
TELEGRAM_ALLOWED_USER_ID=

# --- Google (Gmail + Calendar) ---
# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (APIs: Gmail API, Google Calendar API — create an OAuth Desktop app).
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# --- Home Assistant (domotique) ---
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# --- Voice interface (Raspberry Pi) ---
# A custom "hey_orion" model (wake_word_models/hey_orion.onnx, see
# scripts/wake_word_training/README.md for how it was trained) ships with
# the project, and this default resolves to it automatically — no extra
# setup needed to actually say "Hey Orion". Set to an openWakeWord bundled
# name (e.g. hey_jarvis) or a path to your own model to use something else
# (see README §7).
WAKE_WORD=hey_orion
VOICE_LANGUAGE=fr
# faster-whisper transcription model — "small" (default) is the most
# accurate that's still reasonably fast on a laptop CPU; try "base" or
# "tiny" if replies feel slow to start (each step down roughly halves
# transcription time, at some cost to recognizing uncommon words/names).
WHISPER_MODEL_SIZE=small

# --- Offline fallback (local model via Ollama) ---
# Automatic only: Orion tries Claude first, and only switches to this if a
# Claude call fails for a genuinely offline-shaped reason (no network, an
# Anthropic outage, or an empty account balance) — never on its own
# initiative otherwise, and every offline reply says so plainly. Install
# Ollama separately (https://ollama.com), then pull the model once:
#   ollama pull llama3.1:8b
# If Ollama isn't reachable at OLLAMA_HOST, Orion just behaves as it does
# today — no crash, no fallback, same as any other optional integration
# here. Only a curated subset of tools that make no network call of their
# own are available in this mode (see README §7 for which).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Spotify (music control) ---
# Create an app at https://developer.spotify.com/dashboard, add
# http://localhost:8888/callback as a Redirect URI, then paste the values below.
# Requires Spotify Premium + a device with Spotify Connect active to play audio.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
SPOTIFY_TOKEN_PATH=./spotify_token.json

# --- YouTube + Chromecast/Google TV (casting, Netflix/Disney+/YouTube Music app launch) ---
# Free API key from Google Cloud Console (enable 'YouTube Data API v3'), no OAuth needed.
YOUTUBE_API_KEY=
# Name of your Chromecast/Google TV device, as shown in the Google Home app.
CHROMECAST_NAME=
# Optional: override/add Chromecast app ids as JSON if a default stops working,
# e.g. {"netflix": "XXXXXXXX"}. See README for context on these ids.
CHROMECAST_APP_IDS=

# --- Morning briefing / evening debrief ---
# City used for the weather section of morning_briefing.
HOME_CITY=

# --- CalDAV (Outlook / iCloud / Nextcloud calendars) ---
# For iCloud: CALDAV_URL=https://caldav.icloud.com, username = Apple ID,
# password = an app-specific password from appleid.apple.com.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# --- Todoist ---
# Get a token from Todoist Settings -> Integrations -> Developer.
TODOIST_API_TOKEN=

# --- Obsidian notes ---
# Absolute path to your Obsidian vault folder (or any folder you want
# dictated notes saved into as markdown).
OBSIDIAN_VAULT_PATH=

# --- GitHub release/commit watcher ---
# Optional; raises the public API's rate limit from 60/hr to 5000/hr.
GITHUB_WATCH_TOKEN=

# --- TMDb (movie release dates) ---
# Free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Local backup ---
BACKUP_SOURCE_PATH=
BACKUP_DEST_PATH=

# --- Emergency alert ---
# Comma-separated Telegram chat ids to notify (get ids from @userinfobot).
EMERGENCY_CONTACT_CHAT_IDS=

# --- Sandboxed script execution ---
# Off by default: run_python_snippet lets Orion write and execute short
# Python scripts for one-off automation. Uses an isolated Docker container
# if a Docker daemon is reachable (pip install docker + a running daemon),
# otherwise falls back to a plain subprocess (NOT a hard security sandbox
# in that case) — see tools/sandbox_tools.py for details.
SANDBOX_ENABLED=false

# --- SQL database access (natural-language queries) ---
# Any SQLAlchemy connection string, e.g. sqlite:///./mydata.db or
# postgresql://user:pass@host/dbname (install the matching driver too).
# Read-only by default; run_sql_query requires allow_write=true for writes.
SQL_CONNECTION_STRING=

# --- Named deploy/build/CI commands (voice-triggered, not arbitrary shell) ---
# JSON mapping a name to a fixed shell command, e.g.
# {"build": "make build", "deploy-prod": "./deploy.sh prod"}
DEPLOY_COMMANDS=

# --- ElevenLabs (expressive cloud TTS for the voice interface) ---
# If set, replaces local Piper. Get a key at https://elevenlabs.io.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Edge TTS (free cloud TTS fallback, no API key, no local model file) ---
# Used automatically if ELEVENLABS_API_KEY isn't set and no local Piper voice
# model is found — the zero-setup option for a fresh install (pip install
# edge-tts + an internet connection, nothing to download separately). Already
# defaults from VOICE_LANGUAGE for fr/en, so this only needs setting to
# override the voice or use another language. Full voice list: `edge-tts
# --list-voices`.
EDGE_TTS_VOICE=

# --- Emergency kill switch ---
# A secret phrase the user must say/type exactly to trigger emergency_wipe
# (purges local memory/history and cached OAuth tokens). Leave empty to
# disable the kill switch entirely.
KILL_SWITCH_PHRASE=

# --- Credential leak checking ---
# Optional; only needed for check_email_breached (check_password_leaked
# needs no key — it uses k-anonymity so the password itself is never sent).
HIBP_API_KEY=

# --- Image generation (Google Imagen via the Gemini API) ---
# Separate, usage-billed key from ANTHROPIC_API_KEY — no free tier, a few
# cents per image. Get one at https://aistudio.google.com/apikey.
# generate_image only registers as a tool when this is set.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# --- Website publishing (§13 level 2) ---
# Free/default path: push a site to a GitHub repo and enable Pages.
# GITHUB_PAGES_TOKEN needs the 'repo' scope — https://github.com/settings/tokens
GITHUB_PAGES_TOKEN=
GITHUB_PAGES_OWNER=
# Paid alternative: Infomaniak Web Hosting over SFTP — see your Infomaniak
# Manager for the host/username, and set an SFTP-specific password there.
INFOMANIAK_FTP_HOST=
INFOMANIAK_FTP_USERNAME=
INFOMANIAK_FTP_PASSWORD=

# --- Microsoft 365 (Outlook Mail/Calendar/Contacts) ---
# Register a free public-client app at https://entra.microsoft.com
# (App registrations -> New registration -> no redirect URI needed since
# this uses the device code flow -> Authentication -> enable "Allow public
# client flows" -> API permissions: add Mail.Read, Mail.ReadWrite,
# Calendars.ReadWrite, Contacts.ReadWrite). No client secret needed.
# On first use Orion prints a URL + short code to enter from any device;
# the token is then cached to MICROSOFT_TOKEN_PATH.
MICROSOFT_CLIENT_ID=
MICROSOFT_TOKEN_PATH=./microsoft_token.json

# --- Shopify (e-commerce store management) ---
# In your Shopify admin: Settings -> Apps and sales channels -> Develop apps
# -> Create an app -> Configure Admin API scopes (grant: read_orders,
# write_orders, read_products, write_products, read_inventory,
# write_inventory, read_customers, read_price_rules, write_price_rules)
# -> Install app -> reveal the Admin API access token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
