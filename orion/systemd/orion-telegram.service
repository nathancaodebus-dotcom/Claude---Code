[Unit]
Description=Orion - Telegram interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/orion
EnvironmentFile=/home/pi/orion/.env
ExecStart=/home/pi/orion/.venv/bin/python -m interfaces.telegram_bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
