# --- Core ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
JARVIS_MODEL=claude-sonnet-5
JARVIS_NAME=Jarvis
JARVIS_DB_PATH=./jarvis.db

# --- Telegram interface (Android access) ---
# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user id (get it from @userinfobot).
# Only messages from this id will be answered — keeps your assistant private.
TELEGRAM_ALLOWED_USER_ID=

# --- Google (Gmail + Calendar) ---
# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (APIs: Gmail API, Google Calendar API — create an OAuth Desktop app).
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# --- Home Assistant (domotique) ---
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# --- Voice interface (Raspberry Pi) ---
WAKE_WORD=hey_jarvis
VOICE_LANGUAGE=fr
