[Unit]
Description=Jarvis - voice interface (wake word + mic + speaker)
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jarvis
EnvironmentFile=/home/pi/jarvis/.env
ExecStart=/home/pi/jarvis/.venv/bin/python -m interfaces.voice.voice_loop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
