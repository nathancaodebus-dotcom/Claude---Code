# Reuses the same Anthropic key as Orion — no reason to fragment model
# providers for a service that's just doing conversational tool-use, same
# as Orion itself.
ANTHROPIC_API_KEY=
SHOPPING_ASSISTANT_MODEL=claude-sonnet-5

# --- Shopify Storefront API (NOT the Admin API token Orion's own
# tools/shopify_tools.py uses) ---
# In your Shopify admin: Settings -> Apps and sales channels -> Develop apps
# -> Create an app -> Configure Storefront API scopes (grant at least:
# unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts) -> Install
# app -> reveal the Storefront API access token (different token type from
# the Admin API one, safe to be used from a customer-facing surface).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Comma-separated list of origins allowed to call this backend from a
# browser, e.g. the domain(s) your store is actually reachable at.
SHOPPING_ASSISTANT_ALLOWED_ORIGINS=https://your-store.myshopify.com,https://your-custom-domain.com
